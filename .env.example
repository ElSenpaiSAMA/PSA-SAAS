# Copiar a .env.local y completar con los valores del entorno correspondiente.
# Local: `npx supabase start` imprime la URL y la anon key.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app (se usa en redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entorno lógico de la app: development | staging | production
NEXT_PUBLIC_APP_ENV=development
