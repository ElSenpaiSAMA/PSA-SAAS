# Copiar a .env.local y completar con los valores del entorno correspondiente.
# Local: `npx supabase start` imprime la URL y la anon key.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública de la app (se usa en redirects de auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Entorno lógico de la app: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# IA (opcional). Sin clave, las funciones de IA muestran cómo activarlas.
# Crear la clave en https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Modelo de OpenRouter (por defecto anthropic/claude-sonnet-4.5)
OPENROUTER_MODEL=
# Solo para proxies o pruebas locales con un servidor compatible
OPENROUTER_BASE_URL=

# Opcional: envío del email de invitación de empleados (Supabase Auth).
# Solo servidor, NUNCA con prefijo NEXT_PUBLIC_. Sin esta clave, el admin copia el enlace de activación.
# Supabase → Project Settings → API → service_role. En Supabase → Authentication → URL Configuration,
# sumar <tu-dominio>/activar-cuenta a "Redirect URLs".
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (opcional) ────────────────────────────────────────
# Confirmación al que escribe en el formulario de contacto. Cualquier SMTP sirve:
#   Brevo (gratis, 300/día): smtp-relay.brevo.com, puerto 587, usuario y clave SMTP de Brevo
#   Gmail: smtp.gmail.com, puerto 465, tu Gmail y una "contraseña de aplicación"
# Sin SMTP_HOST no se envían emails (todo lo demás funciona igual).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente visible (en Brevo, un remitente verificado): "Diplonautic <tu@email.com>"
MAIL_FROM=
